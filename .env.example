# LectureLens environment configuration
# Copy to .env and adjust. Secrets must be changed before any real deployment.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Set to true to run pipeline jobs in-process (no Redis/RQ worker needed)
INLINE_JOBS=true

# --- Storage ---
STORAGE_ROOT=/data/storage
MAX_UPLOAD_MB=200
ALLOWED_AUDIO_TYPES=["audio/mpeg","audio/wav","audio/x-wav","audio/mp4","audio/x-m4a","audio/webm","video/mp4","video/webm"]

# --- Database (psycopg2, sync SQLAlchemy) ---
DATABASE_URL=postgresql+psycopg2://lecturelens:lecturelens@localhost:5432/lecturelens

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=lecturelens

# --- Providers: mock | indicconformer | endpoint (ASR); mock | param1 (LLM); mock | indictrans2 (translation)
# mock = deterministic demo output, zero model downloads
ASR_PROVIDER=mock
ASR_MODEL_PATH=/models/indicconformer_asr_base.nemo
ASR_LANGUAGES=hi,kn,ta,te,ml,en
ASR_ENDPOINT_URL=

LLM_PROVIDER=mock
LLM_MODEL_PATH=/models/Param-1-2.9B-Instruct
LLM_ENDPOINT_URL=
LLM_MAX_INPUT_TOKENS=6000

TRANSLATION_PROVIDER=mock
TRANSLATION_MODEL_DIR=/models/indictrans2
TRANSLATION_SOURCE=en
TRANSLATION_TARGET=eng_Latn
